<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sp.system.mapper.NotificationQuestionMapper">

    <resultMap id="NotificationQuestionResult" type="com.sp.system.entity.NotificationQuestion">
        <id property="questionId" column="question_id"/>
        <result property="notificationId" column="notification_id"/>
        <result property="parentQuestionId" column="parent_question_id"/>
        <result property="questionTitle" column="question_title"/>
        <result property="questionType" column="question_type"/>
        <result property="options" column="options"/>
        <result property="isRequired" column="is_required"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="logicRules" column="logic_rules"/>
        <result property="fillBlanks" column="fill_blanks"/>
        <result property="correctAnswers" column="correct_answers"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectQuestionsByNotificationId" resultMap="NotificationQuestionResult">
        SELECT question_id, notification_id, parent_question_id, question_title, 
               question_type, options, is_required, sort_order, logic_rules, 
               fill_blanks, correct_answers, content, create_time
        FROM notification_question
        WHERE notification_id = #{notificationId}
        ORDER BY sort_order ASC
    </select>

</mapper>
