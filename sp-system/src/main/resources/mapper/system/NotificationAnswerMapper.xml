<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sp.system.mapper.NotificationAnswerMapper">

    <resultMap id="NotificationAnswerResult" type="com.sp.system.entity.NotificationAnswer">
        <id property="answerId" column="answer_id"/>
        <result property="notificationId" column="notification_id"/>
        <result property="questionId" column="question_id"/>
        <result property="nodeId" column="node_id"/>
        <result property="nodeTitle" column="node_title"/>
        <result property="nodeType" column="node_type"/>
        <result property="userId" column="user_id"/>
        <result property="userType" column="user_type"/>
        <result property="answerContent" column="answer_content"/>
        <result property="attachmentUrls" column="attachment_urls"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 批量插入答案 -->
    <insert id="batchInsertAnswers" parameterType="java.util.List">
        INSERT INTO notification_answer (
            notification_id, question_id, node_id, node_title, node_type,
            user_id, user_type, answer_content, attachment_urls, create_time
        ) VALUES
        <foreach collection="answers" item="item" separator=",">
            (
                #{item.notificationId},
                #{item.questionId},
                #{item.nodeId},
                #{item.nodeTitle},
                #{item.nodeType},
                #{item.userId},
                #{item.userType},
                #{item.answerContent},
                #{item.attachmentUrls},
                NOW()
            )
        </foreach>
    </insert>

    <!-- 根据通知ID和用户ID查询答案列表 -->
    <select id="selectAnswersByNotificationAndUser" resultMap="NotificationAnswerResult">
        SELECT answer_id, notification_id, question_id, node_id, node_title, node_type,
               user_id, user_type, answer_content, attachment_urls, create_time
        FROM notification_answer
        WHERE notification_id = #{notificationId}
          AND user_id = #{userId}
        ORDER BY question_id, answer_id
    </select>

</mapper>
